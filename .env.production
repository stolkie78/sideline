# SideLine Production Environment
# Copy this to .env on your server and fill in values

# Domain (used by Caddy for automatic HTTPS)
DOMAIN=sideline.example.com

# Public PocketBase URL (must match Caddy subdomain)
PUBLIC_POCKETBASE_URL=https://api.sideline.example.com

# Frontend origin
ORIGIN=https://sideline.example.com

# PocketBase admin credentials
PB_ADMIN_EMAIL=admin@sideline.example.com
PB_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Google OAuth (update redirect URI in Google Console to https://api.sideline.example.com/api/oauth2-redirect)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
