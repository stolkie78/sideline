# SideLine Production Environment
# Copy this to .env on your server and fill in values

# Domain
DOMAIN=www.readplando.com

# Base path for SvelteKit (subpath deployment)
BASE_PATH=/sideline

# Public PocketBase URL (same domain, /sideline/api path)
PUBLIC_POCKETBASE_URL=https://www.readplando.com/sideline/api

# Frontend origin
ORIGIN=https://www.readplando.com

# PocketBase admin credentials
PB_ADMIN_EMAIL=admin@sideline.app
PB_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Google OAuth (update redirect URI to https://www.readplando.com/sideline/api/oauth2-redirect)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
