# SideLine on www.readplando.com/sideline
# PocketBase API at /sideline/api, Frontend at /sideline

www.readplando.com {
	# PocketBase API + Admin
	handle_path /sideline/api/* {
		reverse_proxy pocketbase:8090
	}

	# PocketBase OAuth redirect
	handle /sideline/api/oauth2-redirect {
		reverse_proxy pocketbase:8090
	}

	# Frontend app
	handle_path /sideline/* {
		reverse_proxy frontend:3000
	}

	# Redirect /sideline to /sideline/
	redir /sideline /sideline/ 301
}
