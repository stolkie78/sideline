# SetBaas Production Environment
# Copy this to .env.production on your server, fill in real values, and never commit it.

# Domain
DOMAIN=setbaas.example.com

# Base path for SvelteKit (subpath deployment, leave empty for a dedicated domain)
BASE_PATH=

# Public PocketBase URL
PUBLIC_POCKETBASE_URL=https://setbaas.example.com/api

# Frontend origin
ORIGIN=https://setbaas.example.com

# PocketBase admin credentials
PB_ADMIN_EMAIL=admin@setbaas.example.com
PB_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Google OAuth (update redirect URI to https://setbaas.example.com/api/oauth2-redirect)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Account that gets admin access on every team during setup
OWNER_EMAIL=owner@example.com
