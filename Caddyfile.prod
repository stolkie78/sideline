# SetBaas production — setbaas.nl with automatic Let's Encrypt HTTPS
# Caddy automatically obtains and renews certificates

setbaas.nl {
	# PocketBase API + Admin UI
	handle_path /api/* {
		reverse_proxy pocketbase:8090
	}

	handle_path /_/* {
		reverse_proxy pocketbase:8090
	}

	# Frontend app
	handle /* {
		reverse_proxy frontend:3000
	}
}

# Redirect www to naked domain
www.setbaas.nl {
	redir https://setbaas.nl{uri} permanent
}
